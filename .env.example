# Copy to ~/.config/grokbot-gateway or export in fish. Never commit real values.

# auto | standalone | notch | mock
# GROKBOT_TRANSPORT=auto

# GROKBOT_NOTCH_URL=http://127.0.0.1:4789
# GROKBOT_BIND=127.0.0.1
# GROKBOT_HTTP_PORT=14789
# GROKBOT_BOX_HOST=grokbot-box
# GROKBOT_BOX_USER=box
# GROKBOT_GATEWAY_HOME=~/.config/grokbot-gateway

# Advanced: only if you are not using the desktop session files.
# GROKBOT_ACCESS_TOKEN=
# GROKBOT_MACHINE_ID=
# GROKBOT_TEAM_ID=
# GROKBOT_CLIENT_VERSION=0.71.2
